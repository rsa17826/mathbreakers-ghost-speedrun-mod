
@file /output_log\.txt$
@regex (\n)\n+
@replace $1
@untilfail
@endregex

! @file \.anim$
! @regex clip WalkBack_Right[\s\S]*?\n\n
! @replace
! @endregex
! ! @js

! ! var start = text.indexOf("clip "+"Dodge_")
! ! if (!start)return []
! ! var end = text.substr(start).indexOf("\n\n")
! ! if (!end)return []
! ! return [{start,end,text:''}]
! ! @endjs
